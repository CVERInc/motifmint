---
import Layout from '~/layouts/Layout.astro';
import Hero from '~/components/Hero.svelte';
import Studio from '~/components/Studio.svelte';
---

<Layout>
  <main>
<!-- client:load (not client:only): the hero is the LCP element and pure
         text — SSR paints it with the initial HTML instead of after the whole
         Svelte bundle downloads. Locale detection is client-side, so non-English
         users briefly see the en-US copy; Studio stays client:only (browser-only
         APIs throughout). -->
    <Hero client:load />

    <Studio client:only="svelte" />
  </main>
</Layout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
  }
</style>
